{
    "name": "uams-web/uamswp-list-gravityforms",
    "description": "List all Gravity Forms in a WordPress Multisite installation.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "test:refactor": "rector --dry-run",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "stan": "Analyze first-party PHP with PHPStan.",
        "refactor": "Apply Rector's gating rules.",
        "test:refactor": "Preview Rector's gating rules without changing files.",
        "pint": "Format first-party PHP with Pint.",
        "test:pint": "Check formatting with Pint without changing files."
    }
}
